---
// Brand mark: a fingertip drawn as fingerprint arches, plus a sparkle.
interface Props {
	size?: number;
	class?: string;
}
const { size = 32, class: className } = Astro.props;
---

<svg class:list={["mark", className]} width={size} height={size} viewBox="0 0 48 48" aria-hidden="true" focusable="false">
	<g fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round">
		<path d="M12 42V24a12 12 0 0 1 24 0v18"></path>
		<path d="M17.5 38V25a6.5 6.5 0 0 1 13 0v13"></path>
		<path d="M24 34v-8"></path>
	</g>
	<path class="mark-spark" d="M40 2q.8 5.2 6 6-5.2.8-6 6-.8-5.2-6-6 5.2-.8 6-6z"></path>
</svg>

<style>
	.mark {
		display: block;
		flex: none;
	}
	.mark-spark {
		fill: var(--spark);
	}
</style>
