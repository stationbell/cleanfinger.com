---
import { product } from "../data/product";

interface Props {
	title?: string;
	description?: string;
	/** Extra JSON-LD for this page. */
	jsonLd?: Record<string, unknown>;
	noindex?: boolean;
}

const {
	title = `${product.name} — ${product.headline.join(" ")}`,
	description = product.description,
	jsonLd,
	noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
// Escape "<" so JSON can never close the <script> element early.
const ld = jsonLd ? JSON.stringify(jsonLd).replace(/</g, "\\u003c") : null;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex" />}

		<link rel="preload" href="/fonts/archivo-var-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0c0c0d" media="(prefers-color-scheme: dark)" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={product.name} />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />

		{ld && <script type="application/ld+json" is:inline set:html={ld} />}
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	/* Archivo (SIL OFL, see /fonts/OFL.txt), subset to basic Latin. Weight 400–700, width 100–125%. */
	@font-face {
		font-family: "Archivo";
		src: url("/fonts/archivo-var-latin.woff2") format("woff2");
		font-weight: 400 700;
		font-stretch: 100% 125%;
		font-display: swap;
	}

	:root {
		--bg: #ffffff;
		--ink: #0c0c0d;
		--muted: #5e6066;
		--line: #ececee;
		--stage: #f3f3f4;
		--accent: #2340f5;
		--accent-hover: #1a33d6;
		--accent-text: #2340f5;
		--font: "Archivo", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
		--gutter: 48px;
		color-scheme: light dark;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #0c0c0d;
			--ink: #f3f3f4;
			--muted: #a0a2a8;
			--line: #232427;
			--stage: #141517;
			--accent: #4a63ff;
			--accent-hover: #3a54f5;
			--accent-text: #7d90ff;
		}
	}

	@media (max-width: 760px) {
		:root {
			--gutter: 16px;
		}
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		-webkit-text-size-adjust: 100%;
		text-size-adjust: 100%;
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--ink);
		font: 400 1rem/1.5 var(--font);
		-webkit-font-smoothing: antialiased;
	}

	h1,
	p,
	dl,
	dd,
	ul {
		margin: 0;
	}

	a {
		color: inherit;
	}

	:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	.btn {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 56px;
		padding: 0 28px;
		border-radius: 8px;
		background: var(--accent);
		color: #ffffff;
		font-size: 1.0625rem;
		font-weight: 600;
		text-decoration: none;
		transition: background-color 0.15s ease;
	}
	.btn:hover {
		background: var(--accent-hover);
	}
</style>
