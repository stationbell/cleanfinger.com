---
import Base from "../layouts/Base.astro";
import { product, formattedPrice, cta } from "../data/product";

const year = new Date().getFullYear();

const jsonLd: Record<string, unknown> = {
	"@context": "https://schema.org",
	"@type": "Product",
	name: product.name,
	description: product.description,
	image: new URL("/og.png", Astro.site).href,
	brand: { "@type": "Brand", name: product.name },
	...(product.price !== null && {
		offers: {
			"@type": "Offer",
			price: product.price.toFixed(2),
			priceCurrency: product.currency,
			availability: "https://schema.org/PreOrder",
			url: Astro.site?.href,
		},
	}),
};
---

<Base jsonLd={jsonLd}>
	<div class="page">
		<header class="wrap bar">
			<span class="brand">{product.name}</span>
			<span class="muted">Preorders open</span>
		</header>

		<main class="wrap main">
			<h1>{product.headline}</h1>
			<p class="sub">{product.description}</p>

			<div class="buy">
				<a class="btn" href={cta.href}>{cta.label}</a>
				{formattedPrice && <span class="price">{formattedPrice}</span>}
			</div>
			<p class="note muted">{product.ctaNote}</p>

			<ul class="facts">
				{
					product.facts.map((f) => (
						<li>
							<h2>{f.title}</h2>
							<p class="muted">{f.body}</p>
						</li>
					))
				}
			</ul>
		</main>

		<footer class="wrap bar foot">
			<span>© {year} {product.name}</span>
			<a href={`mailto:${product.contactEmail}`}>{product.contactEmail}</a>
		</footer>
	</div>
</Base>

<style>
	.page {
		display: grid;
		grid-template-rows: auto 1fr auto;
		min-height: 100svh;
	}
	.bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
		padding-block: 22px;
		font-size: 0.9375rem;
	}
	.brand {
		font-weight: 650;
		font-size: 1.0625rem;
		letter-spacing: -0.01em;
	}
	.muted {
		color: var(--muted);
	}

	.main {
		align-self: center;
		padding-block: 32px;
	}
	h1 {
		max-width: 12ch;
		font-size: clamp(2.5rem, 7.5vw, 5.5rem);
		font-weight: 650;
		line-height: 1;
		letter-spacing: -0.04em;
	}
	.sub {
		max-width: 34rem;
		margin-top: 24px;
		font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
		color: var(--muted);
		text-wrap: pretty;
	}
	.buy {
		display: flex;
		align-items: center;
		gap: 20px;
		margin-top: 36px;
	}
	.price {
		font-size: 1.25rem;
		font-weight: 600;
	}
	.note {
		margin-top: 14px;
		font-size: 0.875rem;
	}

	.facts {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
		max-width: 760px;
		margin: clamp(40px, 7vh, 72px) 0 0;
		padding: 20px 0 0;
		border-top: 1px solid var(--line);
		list-style: none;
	}
	.facts h2 {
		font-size: 0.9375rem;
		font-weight: 600;
	}
	.facts p {
		margin-top: 2px;
		font-size: 0.9375rem;
	}
	/* Phones: keep everything on one screen. */
	@media (max-width: 560px) {
		.bar {
			padding-block: 16px;
		}
		.main {
			padding-block: 16px;
		}
		.sub {
			margin-top: 16px;
		}
		.buy {
			margin-top: 28px;
		}
		.facts {
			display: none;
		}
	}

	.foot {
		color: var(--muted);
		border-top: 1px solid var(--line);
	}
	.foot a {
		text-decoration: none;
	}
	.foot a:hover {
		color: var(--ink);
		text-decoration: underline;
	}
	@media (max-width: 560px) {
		.foot {
			font-size: 0.8125rem;
		}
	}
</style>
