---
import Base from "../layouts/Base.astro";
import { product, formattedPrice, cta } from "../data/product";

const year = new Date().getFullYear();

const jsonLd: Record<string, unknown> = {
	"@context": "https://schema.org",
	"@type": "Product",
	name: product.name,
	description: product.description,
	image: new URL("/og.png", Astro.site).href,
	brand: { "@type": "Brand", name: product.name },
	...(product.price !== null && {
		offers: {
			"@type": "Offer",
			price: product.price.toFixed(2),
			priceCurrency: product.currency,
			availability: "https://schema.org/PreOrder",
			url: Astro.site?.href,
		},
	}),
};

// Devices in the illustration, left to right.
const devices = ["monitor", "laptop", "phone"] as const;
---

<Base jsonLd={jsonLd}>
	<div class="page">
		<header class="bar">
			<a class="brand" href="/" aria-label={`${product.name} home`}>
				<span class="brand-a">Clean</span><span class="brand-b">Finger</span>
			</a>
			<span class="muted">Preorders open</span>
		</header>

		<main class="main">
			<section class="copy">
				<p class="kind">{product.kind}</p>
				<h1>{product.headline}</h1>
				<p class="sub">{product.description}</p>

				<div class="buy">
					<dl>
						{
							formattedPrice && (
								<div>
									<dt>Price</dt>
									<dd>{formattedPrice}</dd>
								</div>
							)
						}
						<div>
							<dt>Availability</dt>
							<dd>{product.availability}</dd>
						</div>
					</dl>
					<a class="btn" href={cta.href}>{cta.label}</a>
					<p class="note">{product.ctaNote}</p>
				</div>

				<ul class="benefits">
					{
						product.benefits.map((b) => (
							<li>
								<p class="b-title">{b.title}</p>
								<p class="muted">{b.body}</p>
							</li>
						))
					}
				</ul>
			</section>

			<div class="stage">
				<figure
					class="scene"
					role="img"
					aria-label="Without CleanFinger, a greasy fingertip leaves smudges on a laptop screen. With CleanFinger, the fingertip is wiped first, and the screens stay clear."
				>
					<p class="state" aria-hidden="true">
						<span class="state-without">Without {product.name}</span>
						<span class="state-with">With {product.name}</span>
					</p>

					<div class="finger" aria-hidden="true">
						<span class="nail"></span>
						<img class="grease" src="/grease.svg" alt="" width="100" height="300" decoding="async" />
					</div>

					<div class="devices" aria-hidden="true">
						{
							devices.map((d) => (
								<div class:list={["dev", d]}>
									<div class="bezel">
										<div class="screen">
											<img class="smudge" src="/smudge.svg" alt="" width="748" height="724" decoding="async" />
										</div>
									</div>
									{d === "monitor" && [<span class="m-neck" />, <span class="m-foot" />]}
									{d === "laptop" && <span class="base" />}
								</div>
							))
						}
					</div>
				</figure>
			</div>
		</main>

		<footer class="bar foot">
			<span>© {year} {product.name}</span>
			<a href={`mailto:${product.contactEmail}`}>{product.contactEmail}</a>
		</footer>
	</div>
</Base>

<style>
	.page {
		display: grid;
		grid-template-rows: auto 1fr auto;
		min-height: 100svh;
	}
	.muted {
		color: var(--muted);
	}

	/* Header / footer */
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		height: 72px;
		padding: 0 var(--gutter);
		border-bottom: 1px solid var(--line);
		font-size: 0.9375rem;
	}
	/* Wordmark: one family, two weights. */
	.brand {
		font-size: 1.3125rem;
		font-stretch: 112%;
		letter-spacing: -0.025em;
		line-height: 1;
		text-decoration: none;
	}
	.brand-a {
		font-weight: 700;
	}
	.brand-b {
		font-weight: 400;
	}
	.foot {
		height: 56px;
		border-top: 1px solid var(--line);
		border-bottom: 0;
		font-size: 0.875rem;
		color: var(--muted);
	}
	.foot a {
		text-decoration: none;
	}
	.foot a:hover {
		color: var(--ink);
	}

	/* Main: copy + buy box | illustration */
	.main {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 64px;
		width: 100%;
		max-width: 1440px;
		margin: 0 auto;
		padding: 32px var(--gutter);
	}
	.copy {
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-width: 0;
	}
	.kind {
		margin-bottom: 16px;
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--accent-text);
	}
	h1 {
		max-width: 12em;
		font-size: clamp(2.25rem, min(4.4vw, 7.6vh), 3.875rem);
		font-weight: 700;
		font-stretch: 106%;
		line-height: 1;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}
	.sub {
		max-width: 30em;
		margin-top: 20px;
		font-size: clamp(1.0625rem, 1.4vw, 1.1875rem);
		color: var(--muted);
		text-wrap: pretty;
	}

	/* Buy box */
	.buy {
		max-width: 480px;
		margin-top: clamp(24px, 3.6vh, 32px);
	}
	.buy dl {
		border-top: 1px solid var(--line);
		font-size: 0.9375rem;
	}
	.buy dl div {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		padding: 14px 0;
		border-bottom: 1px solid var(--line);
	}
	.buy dt {
		color: var(--muted);
	}
	.buy dd {
		font-weight: 600;
		text-align: right;
	}
	.buy .btn {
		margin-top: 20px;
	}
	.note {
		margin-top: 12px;
		font-size: 0.875rem;
		color: var(--muted);
		text-align: center;
	}

	/* Benefits */
	.benefits {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 24px;
		max-width: 560px;
		margin-top: clamp(24px, 4vh, 36px);
		padding: 20px 0 0;
		border-top: 1px solid var(--line);
		list-style: none;
		font-size: 0.875rem;
		line-height: 1.45;
	}
	.b-title {
		margin-bottom: 4px;
		font-size: 0.9375rem;
		font-weight: 600;
	}

	/* ---------- Illustration ---------- */
	.stage {
		--finger: #ffffff;
		--finger-line: #d2d3d7;
		--nail: #f6f6f7;
		--bezel: #18191c;
		--body: #d3d4d8;
		--glass: #0d0e10;
		/* How far the fingertip travels down to touch the laptop screen. */
		--tap: 112px;
		position: relative;
		align-self: center;
		height: clamp(400px, 60vh, 540px);
		border-radius: 12px;
		background: var(--stage);
		overflow: hidden;
	}
	@media (prefers-color-scheme: dark) {
		.stage {
			--finger: #1d1e21;
			--finger-line: #3a3b41;
			--nail: #26272b;
			--bezel: #2a2b30;
			--body: #3b3c42;
		}
		.grease {
			filter: brightness(0.65);
		}
	}

	.scene {
		display: flex;
		flex-direction: column;
		height: 100%;
		margin: 0;
		padding: 0 6% 7%;
	}

	/* Indicator: which scene is playing. */
	.state {
		position: absolute;
		top: 18px;
		left: 20px;
		z-index: 3;
		display: grid;
		font-size: 0.8125rem;
		font-weight: 600;
	}
	.state > span {
		grid-area: 1 / 1;
		white-space: nowrap;
	}
	.state > span::before {
		content: "";
		display: inline-block;
		width: 8px;
		height: 8px;
		margin-right: 8px;
		border-radius: 50%;
		background: currentColor;
		vertical-align: 0.05em;
	}
	.state-without {
		color: var(--muted);
	}
	.state-with {
		color: var(--accent-text);
	}

	/* Fingertip, pointing down from the top edge (its top runs off the stage),
	   positioned over the laptop screen. */
	.finger {
		position: relative;
		z-index: 2;
		flex: 1 1 auto;
		align-self: flex-start;
		width: 100px;
		min-height: 120px;
		margin: -60px 0 26px calc(68% - 50px);
		border: 1.5px solid var(--finger-line);
		border-radius: 50px;
		background: var(--finger);
		overflow: hidden;
		-webkit-mask-image: linear-gradient(to bottom, transparent, #000 55%);
		mask-image: linear-gradient(to bottom, transparent, #000 55%);
	}
	.nail {
		position: absolute;
		left: 50%;
		bottom: 9px;
		width: 62px;
		height: 74px;
		transform: translateX(-50%);
		border: 1.5px solid var(--finger-line);
		border-radius: 26px 26px 30px 30px / 22px 22px 40px 40px;
		background: var(--nail);
	}
	.grease {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	/* Devices */
	.devices {
		display: flex;
		align-items: flex-end;
		justify-content: center;
		gap: 4%;
		width: 100%;
	}
	.dev {
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.bezel {
		width: 100%;
		padding: 5px;
		border-radius: 8px;
		background: var(--bezel);
	}
	.screen {
		position: relative;
		border-radius: 4px;
		background: var(--glass);
		overflow: hidden;
	}
	.smudge {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.monitor {
		width: 46%;
	}
	.monitor .screen {
		aspect-ratio: 16 / 10;
	}
	.m-neck {
		width: 14%;
		height: 30px;
		background: var(--body);
	}
	.m-foot {
		width: 38%;
		height: 6px;
		border-radius: 3px;
		background: var(--body);
	}
	.laptop {
		width: 36%;
	}
	.laptop .bezel {
		border-radius: 8px 8px 2px 2px;
	}
	.laptop .screen {
		aspect-ratio: 16 / 10;
	}
	.base {
		width: 118%;
		height: 9px;
		border-radius: 0 0 8px 8px;
		background: var(--body);
	}
	.phone {
		width: 10%;
	}
	.phone .bezel {
		padding: 4px;
		border-radius: 12px;
	}
	.phone .screen {
		aspect-ratio: 9 / 19;
		border-radius: 8px;
	}

	/*
	 * Two scenes, one 5s loop. Screens are never wiped: smudges only ever
	 * APPEAR (from a greasy tap) and are reset off-camera during the cut.
	 *
	 *  Scene 1 "Without CleanFinger"  0–44%
	 *    0–4%    fade in (greasy finger, clean screens)
	 *    10–22%  greasy finger taps the laptop -> smudges appear
	 *    40–43%  fade out
	 *  Cut (scene fully hidden 43–45%): screens reset, label switches at 44%
	 *  Scene 2 "With CleanFinger"  44–100%
	 *    45–48%  fade in (greasy finger, clean screens)
	 *    50–60%  the grease on the FINGER fades away (no wiping motion)
	 *    68–80%  clean finger taps -> screens stay clear
	 *    94–98%  fade out; grease resets off-camera
	 *
	 * Default (no animation / reduced motion) = scene 2's end state.
	 */
	.grease,
	.smudge,
	.state-without {
		opacity: 0;
	}

	@media (prefers-reduced-motion: no-preference) {
		.scene {
			animation: cf-scene 5s infinite;
		}
		.grease {
			animation: cf-grease 5s infinite;
		}
		.finger {
			animation: cf-tap 5s infinite;
		}
		.smudge {
			animation: cf-smudge 5s infinite;
		}
		.state-without {
			animation: cf-without 5s infinite;
		}
		.state-with {
			animation: cf-with 5s infinite;
		}
	}

	@keyframes cf-scene {
		0% {
			opacity: 0;
		}
		4%,
		40% {
			opacity: 1;
		}
		43%,
		45% {
			opacity: 0;
		}
		48%,
		94% {
			opacity: 1;
		}
		98%,
		100% {
			opacity: 0;
		}
	}
	@keyframes cf-without {
		0%,
		43.9% {
			opacity: 1;
		}
		44%,
		100% {
			opacity: 0;
		}
	}
	@keyframes cf-with {
		0%,
		43.9% {
			opacity: 0;
		}
		44%,
		100% {
			opacity: 1;
		}
	}
	@keyframes cf-tap {
		0%,
		10%,
		22%,
		68%,
		80%,
		100% {
			transform: translateY(0);
		}
		15%,
		17%,
		73%,
		75% {
			transform: translateY(var(--tap));
		}
	}
	@keyframes cf-smudge {
		0%,
		15% {
			opacity: 0;
		}
		19%,
		43.9% {
			opacity: 1;
		}
		44%,
		100% {
			opacity: 0;
		}
	}
	@keyframes cf-grease {
		0%,
		50% {
			opacity: 1;
		}
		60%,
		98.9% {
			opacity: 0;
		}
		99%,
		100% {
			opacity: 1;
		}
	}

	/* Short laptop screens */
	@media (min-width: 761px) and (max-height: 820px) {
		.main {
			padding-block: 24px;
		}
		.benefits {
			padding-top: 16px;
		}
	}
	@media (min-width: 761px) and (max-height: 700px) {
		.benefits {
			display: none;
		}
	}

	/* Phones: illustration strip on top (laptop + phone), everything on one screen. */
	@media (max-width: 760px) {
		.bar {
			height: 56px;
		}
		.brand {
			font-size: 1.1875rem;
		}
		.foot {
			height: 48px;
		}
		.main {
			grid-template-columns: minmax(0, 1fr);
			gap: 20px;
			padding: 12px var(--gutter) 24px;
		}
		.stage {
			--tap: 36px;
			order: -1;
			align-self: stretch;
			height: 224px;
		}
		.scene {
			padding: 0 12% 16px;
		}
		.state {
			top: 12px;
			left: auto;
			right: 14px;
			font-size: 0.75rem;
			text-align: right;
		}
		.finger {
			width: 44px;
			min-height: 0;
			margin: -40px 0 14px calc(41% - 22px);
			border-radius: 22px;
		}
		.nail {
			bottom: 5px;
			width: 30px;
			height: 34px;
			border-radius: 12px 12px 14px 14px / 10px 10px 18px 18px;
		}
		.monitor {
			display: none;
		}
		.laptop {
			width: 54%;
		}
		.phone {
			width: 14%;
		}
		.kind {
			margin-bottom: 10px;
		}
		h1 {
			font-size: clamp(1.875rem, 9vw, 2.25rem);
			font-stretch: 100%;
		}
		.sub {
			margin-top: 14px;
		}
		.buy {
			max-width: none;
			margin-top: 22px;
		}
		.benefits {
			display: none;
		}
	}
	@media (max-width: 760px) and (max-height: 720px) {
		.stage {
			display: none;
		}
	}
</style>
