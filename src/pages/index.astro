---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import { product, formattedPrice, cta } from "../data/product";

const year = new Date().getFullYear();

const jsonLd: Record<string, unknown> = {
	"@context": "https://schema.org",
	"@type": "Product",
	name: product.name,
	description: product.description,
	image: new URL("/og.png", Astro.site).href,
	brand: { "@type": "Brand", name: product.name },
	...(product.price !== null && {
		offers: {
			"@type": "Offer",
			price: product.price.toFixed(2),
			priceCurrency: product.currency,
			availability: "https://schema.org/PreOrder",
			url: Astro.site?.href,
		},
	}),
};
---

<Base jsonLd={jsonLd}>
	<div class="page">
		<header class="bar">
			<a class="brand" href="/" aria-label={`${product.name} home`}>
				<Logo />
				<span>{product.name}</span>
			</a>
			<span class="muted">Preorders open</span>
		</header>

		<main class="main">
			<section class="copy">
				<p class="kind muted">{product.kind}</p>
				<h1>{product.headline.map((line, i) => (i ? [<br />, line] : line))}</h1>
				<p class="sub">{product.description}</p>

				<div class="buy">
					<dl>
						{
							formattedPrice && (
								<div>
									<dt>Price</dt>
									<dd>{formattedPrice}</dd>
								</div>
							)
						}
						<div>
							<dt>Availability</dt>
							<dd>{product.availability}</dd>
						</div>
					</dl>
					<a class="btn" href={cta.href}>{cta.label}</a>
					<p class="note">{product.ctaNote}</p>
				</div>

				<ul class="benefits">
					{
						product.benefits.map((b) => (
							<li>
								<p class="b-title">{b.title}</p>
								<p class="muted">{b.body}</p>
							</li>
						))
					}
				</ul>
			</section>

			<figure class="panel">
				<img
					class="smudge"
					src="/smudge.svg"
					alt="Greasy smudges on a dark screen being wiped away"
					width="748"
					height="724"
					decoding="async"
					fetchpriority="high"
				/>
				<span class="sheen" aria-hidden="true"></span>
			</figure>
		</main>

		<footer class="bar foot">
			<span>© {year} {product.name}</span>
			<a href={`mailto:${product.contactEmail}`}>{product.contactEmail}</a>
		</footer>
	</div>
</Base>

<style>
	.page {
		display: grid;
		grid-template-rows: auto 1fr auto;
		min-height: 100svh;
	}
	.muted {
		color: var(--muted);
	}

	/* Header / footer */
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		height: 72px;
		padding: 0 var(--gutter);
		border-bottom: 1px solid var(--line);
		font-size: 0.9375rem;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
		font-size: 1.1875rem;
		font-weight: 700;
		font-stretch: 112%;
		letter-spacing: -0.01em;
	}
	.foot {
		height: 56px;
		border-top: 1px solid var(--line);
		border-bottom: 0;
		font-size: 0.875rem;
		color: var(--muted);
	}
	.foot a {
		text-decoration: none;
	}
	.foot a:hover {
		color: var(--ink);
	}

	/* Main: copy + buy box | image panel */
	.main {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 64px;
		width: 100%;
		max-width: 1440px;
		margin: 0 auto;
		padding: 32px var(--gutter);
	}
	.copy {
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-width: 0;
	}
	.kind {
		margin-bottom: 16px;
		font-size: 0.9375rem;
	}
	h1 {
		font-size: clamp(2.375rem, min(5vw, 8.4vh), 4.25rem);
		font-weight: 700;
		font-stretch: 106%;
		line-height: 0.98;
		letter-spacing: -0.03em;
	}
	.sub {
		max-width: 30em;
		margin-top: 20px;
		font-size: clamp(1.0625rem, 1.4vw, 1.1875rem);
		color: var(--muted);
		text-wrap: pretty;
	}

	/* Buy box */
	.buy {
		max-width: 480px;
		margin-top: clamp(24px, 3.6vh, 32px);
	}
	.buy dl {
		border-top: 1px solid var(--line);
		font-size: 0.9375rem;
	}
	.buy dl div {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		padding: 14px 0;
		border-bottom: 1px solid var(--line);
	}
	.buy dt {
		color: var(--muted);
	}
	.buy dd {
		font-weight: 600;
		text-align: right;
	}
	.buy .btn {
		margin-top: 20px;
	}
	.note {
		margin-top: 12px;
		font-size: 0.875rem;
		color: var(--muted);
		text-align: center;
	}

	/* Benefits */
	.benefits {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 24px;
		max-width: 560px;
		margin-top: clamp(24px, 4vh, 36px);
		padding: 20px 0 0;
		border-top: 1px solid var(--line);
		list-style: none;
		font-size: 0.875rem;
		line-height: 1.45;
	}
	.b-title {
		margin-bottom: 4px;
		font-size: 0.9375rem;
		font-weight: 600;
	}

	/* Image panel */
	.panel {
		position: relative;
		margin: 0;
		min-height: 420px;
		border-radius: 12px;
		background: var(--panel);
		overflow: hidden;
	}
	.smudge,
	.sheen {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.smudge {
		object-fit: cover;
	}

	/*
	 * The wipe. The smudges are masked by a diagonal edge (clean on one side,
	 * smudged on the other) on a 300% box; sliding the box moves the edge across
	 * the panel. The glossy band uses the identical gradient geometry, so it
	 * always sits exactly on that edge. CSS only, no JavaScript.
	 * Positions: 75% = fully smudged, 25% = fully clean, 50% = half (still frame).
	 */
	.smudge {
		--edge: linear-gradient(135deg, transparent 48.5%, #000 51.5%);
		-webkit-mask-image: var(--edge);
		mask-image: var(--edge);
		-webkit-mask-size: 300% 300%;
		mask-size: 300% 300%;
		-webkit-mask-position: 50% 50%;
		mask-position: 50% 50%;
	}
	.sheen {
		background: linear-gradient(
			135deg,
			transparent 46.5%,
			rgb(255 255 255 / 0.05) 48.6%,
			rgb(255 255 255 / 0.14) 50%,
			rgb(255 255 255 / 0.05) 51.4%,
			transparent 53.5%
		);
		background-size: 300% 300%;
		background-position: 50% 50%;
		opacity: 0;
		pointer-events: none;
	}
	@media (prefers-reduced-motion: no-preference) {
		.smudge {
			animation: cf-wipe 6s infinite;
		}
		.sheen {
			animation: cf-sheen 6s infinite;
		}
	}
	@keyframes cf-wipe {
		0%,
		18% {
			-webkit-mask-position: 75% 75%;
			mask-position: 75% 75%;
			opacity: 1;
			animation-timing-function: cubic-bezier(0.55, 0, 0.3, 1);
		}
		48% {
			-webkit-mask-position: 25% 25%;
			mask-position: 25% 25%;
			opacity: 1;
		}
		80% {
			-webkit-mask-position: 25% 25%;
			mask-position: 25% 25%;
			opacity: 0;
		}
		81% {
			-webkit-mask-position: 75% 75%;
			mask-position: 75% 75%;
			opacity: 0;
		}
		100% {
			-webkit-mask-position: 75% 75%;
			mask-position: 75% 75%;
			opacity: 1;
		}
	}
	@keyframes cf-sheen {
		0%,
		18% {
			background-position: 75% 75%;
			opacity: 0;
			animation-timing-function: cubic-bezier(0.55, 0, 0.3, 1);
		}
		22% {
			opacity: 1;
		}
		44% {
			opacity: 1;
		}
		48% {
			background-position: 25% 25%;
			opacity: 0;
		}
		100% {
			background-position: 25% 25%;
			opacity: 0;
		}
	}

	/* Short laptop screens */
	@media (min-width: 761px) and (max-height: 820px) {
		.main {
			padding-block: 24px;
		}
		.benefits {
			padding-top: 16px;
		}
	}
	@media (min-width: 761px) and (max-height: 700px) {
		.benefits {
			display: none;
		}
	}

	/* Phones: image strip on top, everything on one screen. */
	@media (max-width: 760px) {
		.bar {
			height: 56px;
		}
		.foot {
			height: 48px;
		}
		.main {
			grid-template-columns: minmax(0, 1fr);
			gap: 20px;
			padding: 12px var(--gutter) 24px;
		}
		.panel {
			order: -1;
			min-height: 0;
			height: 180px;
		}
		.kind {
			margin-bottom: 10px;
		}
		h1 {
			font-size: clamp(1.875rem, 9vw, 2.25rem);
			font-stretch: 100%;
		}
		.sub {
			margin-top: 14px;
		}
		.buy {
			max-width: none;
			margin-top: 22px;
		}
		.benefits {
			display: none;
		}
	}
	@media (max-width: 760px) and (max-height: 720px) {
		.panel {
			display: none;
		}
	}
</style>
