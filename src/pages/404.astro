---
import Base from "../layouts/Base.astro";
import { product } from "../data/product";
---

<Base title={`Page not found — ${product.name}`} noindex>
	<main class="nf">
		<h1>Page not found.</h1>
		<a class="btn" href="/">Go to {product.name}</a>
	</main>
</Base>

<style>
	.nf {
		display: grid;
		place-content: center;
		justify-items: center;
		gap: 24px;
		min-height: 100svh;
		padding: 24px 16px;
		text-align: center;
	}
	h1 {
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 700;
		font-stretch: 106%;
		letter-spacing: -0.03em;
	}
</style>
