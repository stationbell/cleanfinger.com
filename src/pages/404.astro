---
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import { product } from "../data/product";
---

<Base title={`Page not found — ${product.name}`} noindex>
	<main id="main" class="nf">
		<Mark size={56} />
		<h1>Nothing here.</h1>
		<p>That page doesn't exist — but {product.name} does.</p>
		<a class="btn" href="/">Back to {product.name}</a>
	</main>
</Base>

<style>
	.nf {
		display: grid;
		place-content: center;
		justify-items: center;
		gap: 16px;
		min-height: 100svh;
		padding: 24px 16px;
		text-align: center;
	}
	.nf :global(.mark) {
		color: var(--accent);
	}
	h1 {
		font-size: clamp(2.25rem, 6vw, 3.5rem);
		font-weight: 800;
		letter-spacing: -0.04em;
	}
	p {
		color: var(--muted);
		margin-bottom: 8px;
	}
</style>
