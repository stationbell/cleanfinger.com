{
	"name": "cleanfinger",
	"description": "CleanFinger — single-product storefront. Static Astro site served from Cloudflare's edge.",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro build && wrangler dev",
		"check": "astro check && astro build && wrangler deploy --dry-run",
		"deploy": "astro build && wrangler deploy",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/sitemap": "3.7.4",
		"astro": "7.4.7"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"typescript": "6.0.3",
		"wrangler": "4.158.0"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"workerd@1.20261104.1": true
	}
}
